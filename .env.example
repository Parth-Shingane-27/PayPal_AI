# --- Core (required) -------------------------------------------------------
DATABASE_URL=postgresql://globalcart:globalcart@localhost:5433/globalcart
# Used by `npm test` (integration tests); never point this at real data.
TEST_DATABASE_URL=postgresql://globalcart:globalcart@localhost:5433/globalcart_test
REDIS_URL=redis://localhost:6380
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Public base URL of the Next.js app (PayPal return/cancel URLs point here)
APP_URL=http://localhost:3000
# Demo login is always on outside production; set true to allow it in production.
DEMO_LOGIN=false
# Platform commission in basis points (500 = 5%)
PLATFORM_FEE_BPS=500

# --- Groq (all AI: the four agents, listing text, Assistant routing) -------
GROQ_API_KEY=
# The four agents (multi-step tool use) and the "Create listings" text
GROQ_AGENT_MODEL=openai/gpt-oss-120b
# low | medium | high
GROQ_AGENT_REASONING_EFFORT=medium
# Routes a new seller Assistant conversation to an agent
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# --- PayPal sandbox (needed for checkout, refunds, payouts, webhooks) ------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal developer dashboard (needed by the worker)
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=GlobalCart

# --- Voyage AI (needed for embeddings and product search) ------------------
VOYAGE_API_KEY=

# --- Worker -----------------------------------------------------------------
WORKER_PORT=4000
