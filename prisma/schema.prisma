// GlobalCart data model. Money is always integer minor units plus an ISO
// currency code. Table and column names are snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// CREATED: PayPal order exists, client has not paid. PENDING: capture pending
/// at PayPal. Only CREATED and PENDING may move forward.
enum PaymentStatus {
  CREATED
  PENDING
  COMPLETED
  DECLINED
  FAILED
  VOIDED
}

enum RefundStatus {
  PROPOSED
  REJECTED
  PENDING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum PayoutScheduleStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PROPOSED
  SCHEDULED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum AgentName {
  TREASURY
  PROFILE
  HIRING
  PROJECTS
}

enum ActorType {
  SYSTEM
  FREELANCER
  CLIENT
}

enum AgentSessionStatus {
  IDLE
  RUNNING
}

/// TOOL: a tool call (proposals are TOOL rows that wait for approval).
/// PAYPAL: an outbound PayPal API call. MODEL: token usage for one agent run.
enum Severity {
  LOW
  MEDIUM
  HIGH
}

/// NEW: not yet seen. SEEN: seen. SNOOZED: hidden until snoozed_until.
/// DISMISSED: freelancer does not want it. ACTED: a proposal was made from it.
/// RESOLVED: the detector no longer fires.
enum FindingStatus {
  NEW
  SEEN
  SNOOZED
  DISMISSED
  ACTED
  RESOLVED
}

enum ActionKind {
  TOOL
  PAYPAL
  MODEL
}

enum ActionStatus {
  SUCCEEDED
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Orders and money
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Client-freelancer messaging and service-page traffic
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Agents and audit
// ---------------------------------------------------------------------------

model AgentSession {
  id             String             @id @default(uuid(7)) @db.Uuid
  agent          AgentName
  actor          ActorType
  freelancer_id  String?            @db.Uuid
  client_id      String?            @db.Uuid
  locale         String
  /// The full Claude message history, append-only.
  messages       Json               @default("[]")
  status         AgentSessionStatus @default(IDLE)
  /// When the current run started; a stale RUNNING session can be reclaimed.
  run_started_at DateTime?          @db.Timestamptz(3)
  /// Session that handed off to this one, if any.
  parent_id      String?            @db.Uuid
  created_at     DateTime           @default(now()) @db.Timestamptz(3)
  updated_at     DateTime           @updatedAt @db.Timestamptz(3)

  freelancer    Freelancer?    @relation(fields: [freelancer_id], references: [id])
  client        Client?        @relation(fields: [client_id], references: [id])
  parent        AgentSession?  @relation("Handoff", fields: [parent_id], references: [id])
  children      AgentSession[] @relation("Handoff")
  agent_actions AgentAction[]

  @@index([freelancer_id])
  @@index([client_id])
  @@map("agent_sessions")
}

/// Audit log and approval queue. A proposal is a PENDING_APPROVAL row linked
/// to a refund or payout schedule, created in the same transaction.
model AgentAction {
  id                            String       @id @default(uuid(7)) @db.Uuid
  kind                          ActionKind
  agent                         AgentName?
  tool                          String
  input                         Json
  output                        Json?
  status                        ActionStatus
  error                         String?
  rationale                     String?
  actor                         ActorType
  actor_id                      String?      @db.Uuid
  session_id                    String?      @db.Uuid
  freelancer_id                 String?      @db.Uuid
  milestone_refund_id           String?      @db.Uuid
  freelancer_payout_schedule_id String?      @db.Uuid
  decided_by                    String?      @db.Uuid
  decided_at                    DateTime?    @db.Timestamptz(3)
  duration_ms                   Int?
  created_at                    DateTime     @default(now()) @db.Timestamptz(3)

  session                    AgentSession?             @relation(fields: [session_id], references: [id])
  freelancer                 Freelancer?               @relation(fields: [freelancer_id], references: [id])
  milestone_refund           MilestoneRefund?          @relation(fields: [milestone_refund_id], references: [id])
  freelancer_payout_schedule FreelancerPayoutSchedule? @relation(fields: [freelancer_payout_schedule_id], references: [id])

  @@index([freelancer_id, created_at])
  @@index([session_id, created_at])
  @@index([status])
  @@map("agent_actions")
}

model WebhookEvent {
  /// PayPal event id; storing it as the key makes delivery idempotent.
  id            String        @id
  event_type    String
  resource_type String?
  resource_id   String?
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  error         String?
  received_at   DateTime      @default(now()) @db.Timestamptz(3)
  processed_at  DateTime?     @db.Timestamptz(3)

  @@index([status])
  @@map("webhook_events")
}

/// A proactive observation by the Treasury or Operations agent. One open row
/// per (freelancer_id, fingerprint); see the partial unique index in the migration.
model Finding {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// GlobalCart findings; null for GlobalGig ones (removed with the GlobalCart tables).
  freelancer_id String?       @db.Uuid
  agent         AgentName
  type          String
  /// type:subject, e.g. refund_rate:de-DE. Stable across runs.
  fingerprint   String
  severity      Severity
  title         String
  body          String
  evidence      Json
  status        FindingStatus @default(NEW)
  snoozed_until DateTime?     @db.Timestamptz(3)
  /// Agent session that wrote it, so "Discuss" continues the same conversation.
  session_id    String?       @db.Uuid
  /// Payout proposal drafted from this finding, if any.
  action_id     String?       @db.Uuid
  first_seen_at DateTime      @default(now()) @db.Timestamptz(3)
  last_seen_at  DateTime      @default(now()) @db.Timestamptz(3)
  created_at    DateTime      @default(now()) @db.Timestamptz(3)

  freelancer Freelancer? @relation(fields: [freelancer_id], references: [id])

  @@index([freelancer_id, status])
  @@map("findings")
}

// ===========================================================================
// GlobalGig: freelancers sell services to clients in other countries.
// Clients fund each milestone through PayPal into the platform account; the
// money is "in holding" until the client accepts the delivery (or the worker
// auto-releases it), and only then becomes available to the freelancer.
// ===========================================================================

enum Availability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum PricingModel {
  PACKAGES
  HOURLY
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BriefStatus {
  DRAFT
  OPEN
  CLOSED
}

/// REQUESTED: the client asked, the freelancer has not priced it yet.
/// SENT: the freelancer sent a price. ACCEPTED: a contract was made from it.
enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ContractSource {
  PACKAGE
  QUOTE
}

/// DRAFT: milestone plan proposed, nothing funded. ACTIVE: at least one
/// milestone funded. COMPLETED: every milestone accepted or refunded.
enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// See src/server/domain/milestones.ts for the transitions. Money is in
/// holding in FUNDED, IN_PROGRESS, DELIVERED, REVISION_REQUESTED and DISPUTED,
/// and released (available to the freelancer) only in ACCEPTED.
enum MilestoneState {
  AWAITING_FUNDING
  FUNDED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  ACCEPTED
  DISPUTED
  REFUNDED
  CANCELLED
}

/// How a milestone reached ACCEPTED.
enum ReleaseKind {
  CLIENT_ACCEPTED
  AUTO_RELEASED
  DISPUTE_RESOLVED
}

model Freelancer {
  id                    String                       @id @default(uuid(7)) @db.Uuid
  name                  String
  email                 String                       @unique
  /// PayPal account that receives payouts.
  paypal_email          String
  /// ISO 3166-1 alpha-2.
  country               String                       @db.Char(2)
  /// Home currency the freelancer is paid out in.
  currency              String                       @db.Char(3)
  /// UI and agent reply language, e.g. "en-US", "de-DE".
  locale                String
  headline              String                       @default("")
  bio                   String                       @default("")
  skills                String[]                     @default([])
  /// Languages spoken, as BCP 47 language tags ("en", "de", "hi").
  languages             String[]                     @default([])
  /// IANA time zone, e.g. "Asia/Kolkata".
  timezone              String
  availability          Availability                 @default(AVAILABLE)
  portfolio_links       String[]                     @default([])
  /// No suggested rate goes below this, in `currency` minor units per hour.
  hourly_floor_minor    Int
  /// Short code in invoice numbers, e.g. "PRK" -> GG-PRK-000042.
  invoice_prefix        String                       @unique
  /// Last invoice number issued; incremented under a row lock.
  invoice_seq           Int                          @default(0)
  /// Opt-in: the Treasury agent may draft payout proposals by itself (still approved by the freelancer).
  auto_payout_proposals Boolean                      @default(false)
  /// Skills + headline embedding for client search.
  embedding             Unsupported("vector(1024)")?
  embedded_at           DateTime?                    @db.Timestamptz(3)
  created_at            DateTime                     @default(now()) @db.Timestamptz(3)

  services         Service[]
  service_pages    ServicePage[]
  market_research  MarketRateResearch[]
  quotes           Quote[]
  contracts        Contract[]
  milestones       Milestone[]
  payments         MilestonePayment[]
  refunds          MilestoneRefund[]
  invoices         Invoice[]
  threads          Thread[]
  payout_schedules FreelancerPayoutSchedule[]
  payouts          FreelancerPayout[]
  agent_sessions   AgentSession[]
  agent_actions    AgentAction[]
  findings         Finding[]

  @@map("freelancers")
}

model Client {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  /// Default market; the session can override it from the market picker.
  locale       String
  country      String   @db.Char(2)
  /// Set when the client hires as a company.
  company_name String?
  /// VAT / tax ID exactly as the client typed it. Printed on invoices, never validated or used in any calculation.
  tax_id       String?
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  briefs         Brief[]
  quotes         Quote[]
  contracts      Contract[]
  milestones     Milestone[]
  payments       MilestonePayment[]
  invoices       Invoice[]
  threads        Thread[]
  agent_sessions AgentSession[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// Services and localized service pages
// ---------------------------------------------------------------------------

model Service {
  id                String       @id @default(uuid(7)) @db.Uuid
  freelancer_id     String       @db.Uuid
  /// Freelancer's own short code, unique per freelancer.
  code              String
  /// Source-language title and description, written by the freelancer.
  title             String
  description       String
  source_locale     String
  category          String
  tags              String[]     @default([])
  pricing_model     PricingModel
  /// Base prices (packages and hourly rate) are in this currency, the freelancer's home currency.
  currency          String       @db.Char(3)
  /// HOURLY services only.
  hourly_rate_minor Int?
  image_url         String?
  rating_avg        Float?
  rating_count      Int          @default(0)
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @updatedAt @db.Timestamptz(3)

  freelancer      Freelancer           @relation(fields: [freelancer_id], references: [id])
  packages        ServicePackage[]
  pages           ServicePage[]
  market_research MarketRateResearch[]
  quotes          Quote[]
  contracts       Contract[]
  threads         Thread[]

  @@unique([freelancer_id, code])
  @@index([freelancer_id])
  @@map("services")
}

/// Basic / Standard / Premium: scope, delivery time and revisions for a fixed price.
model ServicePackage {
  id               String      @id @default(uuid(7)) @db.Uuid
  service_id       String      @db.Uuid
  tier             PackageTier
  name             String
  scope            String
  deliverables     String[]    @default([])
  delivery_days    Int
  revisions        Int
  /// The freelancer's own estimate; the rate floor is estimated_hours x hourly floor.
  estimated_hours  Int
  /// In the service currency.
  base_price_minor Int

  service   Service            @relation(fields: [service_id], references: [id], onDelete: Cascade)
  prices    ServicePagePrice[]
  quotes    Quote[]
  contracts Contract[]

  @@unique([service_id, tier])
  @@map("service_packages")
}

/// One service page per market: localized copy and prices in the market currency.
model ServicePage {
  id                String                       @id @default(uuid(7)) @db.Uuid
  service_id        String                       @db.Uuid
  freelancer_id     String                       @db.Uuid
  locale            String
  currency          String                       @db.Char(3)
  title             String
  description       String
  seo_title         String
  /// HOURLY services: the rate in this market.
  hourly_rate_minor Int?
  status            PageStatus                   @default(DRAFT)
  /// The suggest_rate result the prices came from (null if set by hand).
  pricing           Json?
  embedding         Unsupported("vector(1024)")?
  embedded_at       DateTime?                    @db.Timestamptz(3)
  published_at      DateTime?                    @db.Timestamptz(3)
  created_at        DateTime                     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                     @updatedAt @db.Timestamptz(3)

  service     Service                @relation(fields: [service_id], references: [id], onDelete: Cascade)
  freelancer  Freelancer             @relation(fields: [freelancer_id], references: [id])
  prices      ServicePagePrice[]
  daily_stats ServicePageDailyStat[]

  @@unique([service_id, locale])
  @@index([locale, status])
  @@index([freelancer_id])
  @@map("service_pages")
}

/// A package's price on one service page, in the page currency.
model ServicePagePrice {
  page_id     String @db.Uuid
  package_id  String @db.Uuid
  price_minor Int

  page    ServicePage    @relation(fields: [page_id], references: [id], onDelete: Cascade)
  package ServicePackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@id([page_id, package_id])
  @@map("service_page_prices")
}

/// What comparable freelance services cost in one market (freelance platforms
/// and agency rate pages), converted into the market currency by code.
model MarketRateResearch {
  id            String   @id @default(uuid(7)) @db.Uuid
  freelancer_id String   @db.Uuid
  /// Null while the service is still being added; linked by query_hash on creation.
  service_id    String?  @db.Uuid
  query_hash    String?
  locale        String
  currency      String   @db.Char(3)
  result        Json
  offer_count   Int
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  freelancer Freelancer @relation(fields: [freelancer_id], references: [id])
  service    Service?   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, locale, created_at])
  @@index([freelancer_id, query_hash, locale, created_at])
  @@map("market_rate_research")
}

/// Daily traffic per service page.
model ServicePageDailyStat {
  page_id        String   @db.Uuid
  day            DateTime @db.Date
  views          Int      @default(0)
  quote_requests Int      @default(0)
  /// Contracts started from this page that day.
  contracts      Int      @default(0)

  page ServicePage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@id([page_id, day])
  @@map("service_page_daily_stats")
}

// ---------------------------------------------------------------------------
// Briefs, quotes, contracts, milestones
// ---------------------------------------------------------------------------

model Brief {
  id              String      @id @default(uuid(7)) @db.Uuid
  client_id       String      @db.Uuid
  title           String
  /// The client's own words. Data, never instructions.
  description     String
  /// Language the brief is written in.
  locale          String
  skills          String[]    @default([])
  budget_minor    Int?
  budget_currency String?     @db.Char(3)
  deadline        DateTime?   @db.Date
  status          BriefStatus @default(DRAFT)
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @updatedAt @db.Timestamptz(3)

  client  Client   @relation(fields: [client_id], references: [id])
  quotes  Quote[]
  threads Thread[]

  @@index([client_id, status])
  @@map("briefs")
}

/// A client asks a freelancer for a price (REQUESTED); the freelancer answers (SENT).
model Quote {
  id              String      @id @default(uuid(7)) @db.Uuid
  client_id       String      @db.Uuid
  freelancer_id   String      @db.Uuid
  brief_id        String?     @db.Uuid
  service_id      String?     @db.Uuid
  package_id      String?     @db.Uuid
  /// Client's market: the quote is priced in its currency.
  locale          String
  currency        String      @db.Char(3)
  status          QuoteStatus @default(REQUESTED)
  request_message String
  /// Null until the freelancer sends a price.
  total_minor     Int?
  delivery_days   Int?
  revisions       Int?
  scope           String?
  /// The freelancer's note with the price.
  message         String?
  requested_at    DateTime    @default(now()) @db.Timestamptz(3)
  sent_at         DateTime?   @db.Timestamptz(3)
  decided_at      DateTime?   @db.Timestamptz(3)
  expires_at      DateTime?   @db.Timestamptz(3)
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @updatedAt @db.Timestamptz(3)

  client     Client          @relation(fields: [client_id], references: [id])
  freelancer Freelancer      @relation(fields: [freelancer_id], references: [id])
  brief      Brief?          @relation(fields: [brief_id], references: [id])
  service    Service?        @relation(fields: [service_id], references: [id])
  package    ServicePackage? @relation(fields: [package_id], references: [id])
  contract   Contract?
  threads    Thread[]

  @@index([freelancer_id, status])
  @@index([client_id, status])
  @@map("quotes")
}

/// One client, one freelancer, one currency. Milestones add up to total_minor.
model Contract {
  id                String         @id @default(uuid(7)) @db.Uuid
  client_id         String         @db.Uuid
  freelancer_id     String         @db.Uuid
  source            ContractSource
  service_id        String?        @db.Uuid
  package_id        String?        @db.Uuid
  quote_id          String?        @unique @db.Uuid
  title             String
  scope             String
  /// Client's market, e.g. "de-DE".
  locale            String
  currency          String         @db.Char(3)
  total_minor       Int
  revisions_allowed Int
  status            ContractStatus @default(DRAFT)
  activated_at      DateTime?      @db.Timestamptz(3)
  completed_at      DateTime?      @db.Timestamptz(3)
  created_at        DateTime       @default(now()) @db.Timestamptz(3)
  updated_at        DateTime       @updatedAt @db.Timestamptz(3)

  client     Client             @relation(fields: [client_id], references: [id])
  freelancer Freelancer         @relation(fields: [freelancer_id], references: [id])
  service    Service?           @relation(fields: [service_id], references: [id])
  package    ServicePackage?    @relation(fields: [package_id], references: [id])
  quote      Quote?             @relation(fields: [quote_id], references: [id])
  milestones Milestone[]
  payments   MilestonePayment[]
  refunds    MilestoneRefund[]
  invoices   Invoice[]
  threads    Thread[]

  @@index([client_id, status])
  @@index([freelancer_id, status])
  @@map("contracts")
}

model Milestone {
  id              String         @id @default(uuid(7)) @db.Uuid
  contract_id     String         @db.Uuid
  /// Denormalised from the contract so owner filters and ledger sums need no join.
  freelancer_id   String         @db.Uuid
  client_id       String         @db.Uuid
  /// 1-based order within the contract.
  position        Int
  title           String
  description     String         @default("")
  currency        String         @db.Char(3)
  amount_minor    Int
  due_date        DateTime?      @db.Date
  state           MilestoneState @default(AWAITING_FUNDING)
  revision_count  Int            @default(0)
  funded_at       DateTime?      @db.Timestamptz(3)
  started_at      DateTime?      @db.Timestamptz(3)
  delivered_at    DateTime?      @db.Timestamptz(3)
  /// delivered_at + AUTO_RELEASE_DAYS; cleared when the client responds.
  auto_release_at DateTime?      @db.Timestamptz(3)
  released_at     DateTime?      @db.Timestamptz(3)
  release_kind    ReleaseKind?
  disputed_at     DateTime?      @db.Timestamptz(3)
  dispute_reason  String?
  created_at      DateTime       @default(now()) @db.Timestamptz(3)
  updated_at      DateTime       @updatedAt @db.Timestamptz(3)

  contract    Contract           @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  freelancer  Freelancer         @relation(fields: [freelancer_id], references: [id])
  client      Client             @relation(fields: [client_id], references: [id])
  payments    MilestonePayment[]
  refunds     MilestoneRefund[]
  events      MilestoneEvent[]
  invoice     Invoice?
  attachments Attachment[]

  @@unique([contract_id, position])
  @@index([freelancer_id, state])
  @@index([client_id, state])
  @@index([state, auto_release_at])
  @@map("milestones")
}

/// Every milestone state change, with who made it.
model MilestoneEvent {
  id           String         @id @default(uuid(7)) @db.Uuid
  milestone_id String         @db.Uuid
  event        String
  from_state   MilestoneState
  to_state     MilestoneState
  actor        ActorType
  actor_id     String?        @db.Uuid
  note         String?
  created_at   DateTime       @default(now()) @db.Timestamptz(3)

  milestone Milestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@index([milestone_id, created_at])
  @@map("milestone_events")
}

// ---------------------------------------------------------------------------
// Milestone money
// ---------------------------------------------------------------------------

/// One row per PayPal order attempt for a milestone. Fees are measured at
/// capture; net_to_freelancer is recorded when the milestone is released.
model MilestonePayment {
  id                      String        @id @default(uuid(7)) @db.Uuid
  milestone_id            String        @db.Uuid
  contract_id             String        @db.Uuid
  freelancer_id           String        @db.Uuid
  client_id               String        @db.Uuid
  paypal_order_id         String        @unique
  approve_url             String?
  /// `${milestoneId}-${uuid}`: PayPal invoice_id and PayPal-Request-Id.
  paypal_invoice_id       String        @unique
  status                  PaymentStatus @default(CREATED)
  currency                String        @db.Char(3)
  gross_minor             Int
  paypal_fee_minor        Int?
  fee_is_estimate         Boolean       @default(false)
  platform_fee_minor      Int?
  fx_cost_minor           Int?
  /// Set on release: gross - PayPal fee - platform fee - FX cost (less anything refunded before release).
  net_to_freelancer_minor Int?
  capture_id              String?       @unique
  failure_reason          String?
  captured_at             DateTime?     @db.Timestamptz(3)
  released_at             DateTime?     @db.Timestamptz(3)
  created_at              DateTime      @default(now()) @db.Timestamptz(3)
  updated_at              DateTime      @updatedAt @db.Timestamptz(3)

  milestone  Milestone         @relation(fields: [milestone_id], references: [id])
  contract   Contract          @relation(fields: [contract_id], references: [id])
  freelancer Freelancer        @relation(fields: [freelancer_id], references: [id])
  client     Client            @relation(fields: [client_id], references: [id])
  refunds    MilestoneRefund[]

  @@index([milestone_id])
  @@index([freelancer_id, status])
  @@index([status])
  @@map("milestone_payments")
}

model MilestoneRefund {
  id                          String       @id @default(uuid(7)) @db.Uuid
  payment_id                  String       @db.Uuid
  milestone_id                String       @db.Uuid
  contract_id                 String       @db.Uuid
  freelancer_id               String       @db.Uuid
  currency                    String       @db.Char(3)
  amount_minor                Int
  reason                      String
  /// True when the milestone was not yet released: the refund comes out of holding, not the freelancer's balance.
  from_holding                Boolean
  status                      RefundStatus @default(PROPOSED)
  paypal_refund_id            String?      @unique
  paypal_fee_returned_minor   Int?
  platform_fee_returned_minor Int?
  /// Debited from the freelancer's released balance (0 for a refund from holding).
  freelancer_debit_minor      Int?
  error                       String?
  created_at                  DateTime     @default(now()) @db.Timestamptz(3)
  completed_at                DateTime?    @db.Timestamptz(3)

  payment       MilestonePayment @relation(fields: [payment_id], references: [id])
  milestone     Milestone        @relation(fields: [milestone_id], references: [id])
  contract      Contract         @relation(fields: [contract_id], references: [id])
  freelancer    Freelancer       @relation(fields: [freelancer_id], references: [id])
  agent_actions AgentAction[]

  @@index([freelancer_id, status])
  @@index([payment_id])
  @@map("milestone_refunds")
}

/// One invoice per released milestone, in the client's currency and language.
/// Amounts and the client's tax ID as entered; no tax is calculated.
model Invoice {
  id                 String   @id @default(uuid(7)) @db.Uuid
  freelancer_id      String   @db.Uuid
  client_id          String   @db.Uuid
  contract_id        String   @db.Uuid
  milestone_id       String   @unique @db.Uuid
  /// Sequential per freelancer, gap-free.
  seq                Int
  number             String
  locale             String
  currency           String   @db.Char(3)
  /// Line items as computed by src/server/domain/invoices.ts.
  lines              Json
  total_minor        Int
  /// Snapshots, so a later profile edit does not change an issued invoice.
  freelancer_name    String
  freelancer_country String   @db.Char(2)
  client_name        String
  client_company     String?
  client_tax_id      String?
  issued_at          DateTime @default(now()) @db.Timestamptz(3)

  freelancer Freelancer @relation(fields: [freelancer_id], references: [id])
  client     Client     @relation(fields: [client_id], references: [id])
  contract   Contract   @relation(fields: [contract_id], references: [id])
  milestone  Milestone  @relation(fields: [milestone_id], references: [id])

  @@unique([freelancer_id, seq])
  @@index([client_id, issued_at])
  @@map("invoices")
}

model FreelancerPayoutSchedule {
  id            String               @id @default(uuid(7)) @db.Uuid
  freelancer_id String               @db.Uuid
  currency      String               @db.Char(3)
  status        PayoutScheduleStatus @default(PROPOSED)
  created_at    DateTime             @default(now()) @db.Timestamptz(3)

  freelancer    Freelancer         @relation(fields: [freelancer_id], references: [id])
  payouts       FreelancerPayout[]
  agent_actions AgentAction[]

  @@index([freelancer_id])
  @@map("freelancer_payout_schedules")
}

model FreelancerPayout {
  id              String       @id @default(uuid(7)) @db.Uuid
  schedule_id     String       @db.Uuid
  freelancer_id   String       @db.Uuid
  currency        String       @db.Char(3)
  amount_minor    Int
  fee_minor       Int
  fee_is_estimate Boolean      @default(true)
  receiver_email  String
  scheduled_for   DateTime     @db.Timestamptz(3)
  status          PayoutStatus @default(PROPOSED)
  sender_batch_id String       @unique
  paypal_batch_id String?      @unique
  error           String?
  completed_at    DateTime?    @db.Timestamptz(3)
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @updatedAt @db.Timestamptz(3)

  schedule   FreelancerPayoutSchedule @relation(fields: [schedule_id], references: [id])
  freelancer Freelancer               @relation(fields: [freelancer_id], references: [id])

  @@index([freelancer_id, status])
  @@map("freelancer_payouts")
}

// ---------------------------------------------------------------------------
// Project workspace threads
// ---------------------------------------------------------------------------

model Thread {
  id                String             @id @default(uuid(7)) @db.Uuid
  freelancer_id     String             @db.Uuid
  client_id         String             @db.Uuid
  service_id        String?            @db.Uuid
  brief_id          String?            @db.Uuid
  quote_id          String?            @db.Uuid
  contract_id       String?            @db.Uuid
  subject           String
  status            ConversationStatus @default(OPEN)
  last_message_at   DateTime           @default(now()) @db.Timestamptz(3)
  freelancer_unread Int                @default(0)
  client_unread     Int                @default(0)
  created_at        DateTime           @default(now()) @db.Timestamptz(3)
  updated_at        DateTime           @updatedAt @db.Timestamptz(3)

  freelancer  Freelancer      @relation(fields: [freelancer_id], references: [id])
  client      Client          @relation(fields: [client_id], references: [id])
  service     Service?        @relation(fields: [service_id], references: [id])
  brief       Brief?          @relation(fields: [brief_id], references: [id])
  quote       Quote?          @relation(fields: [quote_id], references: [id])
  contract    Contract?       @relation(fields: [contract_id], references: [id])
  messages    ThreadMessage[]
  attachments Attachment[]

  @@index([freelancer_id, last_message_at])
  @@index([client_id, last_message_at])
  @@map("threads")
}

model ThreadMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  thread_id   String    @db.Uuid
  /// FREELANCER or CLIENT.
  sender      ActorType
  body        String
  body_locale String
  /// Rendering in the other party's language, when they differ.
  translation String?
  created_at  DateTime  @default(now()) @db.Timestamptz(3)

  thread      Thread       @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([thread_id, created_at])
  @@map("thread_messages")
}

/// A file shared in a thread, optionally as a milestone deliverable. The file
/// itself lives in storage (local disk in dev) under storage_key.
model Attachment {
  id           String    @id @default(uuid(7)) @db.Uuid
  thread_id    String    @db.Uuid
  message_id   String?   @db.Uuid
  milestone_id String?   @db.Uuid
  uploaded_by  ActorType
  file_name    String
  content_type String
  size_bytes   Int
  storage_key  String    @unique
  created_at   DateTime  @default(now()) @db.Timestamptz(3)

  thread    Thread         @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  message   ThreadMessage? @relation(fields: [message_id], references: [id], onDelete: SetNull)
  milestone Milestone?     @relation(fields: [milestone_id], references: [id], onDelete: SetNull)

  @@index([milestone_id])
  @@map("attachments")
}
